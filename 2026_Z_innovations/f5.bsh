do ilev = 0, nlev-1
   do ivar = 0, nvar-1
      if(var4plt_list(ivar).ne."npts") then
         pres@lbTitleString    = "[dBZ]"
      else
         pres@lbTitleString    = ""
      end if
      do iLeadTime = 0, nLeadTime-1 
	 plotsNd_old = mpid(:,:,iLeadTime,ilev,ivar)     
	 plotsNd_old!0 = "Season"
	 plotsNd_old!1 = "var4stats"
	 plotsNd_new = plotsNd_old(var4stats|:, Season|:)
	 gsn_panel(wks,ndtooned(plotsNd_new(:,:)),(/nvar4stats,nseason/),pres)
         frame(wks)
	 delete([/plotsNd_old,plotsNd_new/])
      end do	 
   end do
